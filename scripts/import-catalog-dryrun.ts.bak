function resolveNameEn(product: string): string {
  // 先精确匹配（含后缀如括号内容）
  if (EN_NAME_MAP[product]) return EN_NAME_MAP[product]
  // 去括号后缀再匹配
  const base = product.replace(/[（(].*?[）)]/g, '').trim()
  if (EN_NAME_MAP[base]) return EN_NAME_MAP[base]
  // 兜底：返回中文名（后续可接入 pinyin）
  return product
}

// ─── SKU 生成 ─────────────────────────────────────────────────────────────────

const CAT_SHORT: Record<string, string> = {
  'engine-parts': 'ENG',
  'drivetrain': 'DRIVE',
  'chassis-suspension': 'CHASSIS',
  'electrical': 'ELEC',
  'filters': 'FILTER',
  'other': 'OTHER',
}

function makeSku(cat: string, idx: number): string {
  const short = CAT_SHORT[cat] || 'UNK'
  return `DD-${short}-${String(idx).padStart(3, '0')}`
}

// ─── 解析 Markdown ────────────────────────────────────────────────────────────

interface Entry {
  h2: string
  h3: string
  h4: string       // 可为空
  product: string
  model: string
  brand: string
  price: string
  category: string
  name_en: string
  sku: string
  oem_placeholder: string
}

function parseCatalog(mdPath: string): Entry[] {
  const content = fs.readFileSync(mdPath, 'utf-8')
  const lines = content.split('\n')

  const entries: Entry[] = []
  let h2 = '', h3 = '', h4 = ''
  let entryIdx = 0

  for (const line of lines) {
    // Track headings
    if (line.startsWith('#### ')) {
      h4 = line.replace(/^####\s+/, '').trim()
    } else if (line.startsWith('### ')) {
      h3 = line.replace(/^###\s+/, '').trim()
      h4 = ''
    } else if (line.startsWith('## ') && !line.startsWith('###')) {
      h2 = line.replace(/^##\s+/, '').trim()
      h3 = ''
      h4 = ''
    }
    // Parse table rows
    else if (line.startsWith('|') && !line.includes('---') && !line.includes('序号')) {
      const cells = line.split('|').slice(1, -1).map(c => c.trim())
      if (cells.length >= 2 && /^\d+$/.test(cells[0])) {
        entryIdx++
        const product = cells[1] || ''
        const model = cells[2] || ''
        const brand = cells[3] || ''
        const price = cells[4] || ''

        // Determine category: prefer h4, fallback to product keyword inference
        let category: string
        if (h4) {
          category = H4_CATEGORY_MAP[h4] || inferCategoryFromProduct(product)
        } else {
          category = inferCategoryFromProduct(product)
        }

        const nameEn = resolveNameEn(product)
        const sku = makeSku(category, entries.filter(e => e.category === category).length + 1)
        // Per-category counter for SKU
        // Actually need a global counter per category - let's use a map
        // For now, use entryIdx (global) - we'll fix below

        entries.push({
          h2, h3, h4, product, model, brand, price,
          category, name_en: nameEn,
          sku: '', // placeholder, will fix below
          oem_placeholder: '', // placeholder
        })
      }
    }
  }

  // Assign SKUs with per-category counters
  const catCounters = new Map<string, number>()
  for (const e of entries) {
    const cnt = (catCounters.get(e.category) || 0) + 1
    catCounters.set(e.category, cnt)
    e.sku = `DD-${CAT_SHORT[e.category] || 'UNK'}-${String(cnt).padStart(3, '0')}`
    e.oem_placeholder = e.sku // placeholder until real OEM is provided
  }

  return entries
}

// ─── 统计输出 ─────────────────────────────────────────────────────────────────

function printStats(entries: Entry[]): void {
  console.log('═'.repeat(72))
  console.log('  产品目录导入 DRY-RUN 报告')
  console.log('  来源：产品目录_德达汽配.md')
  console.log('═'.repeat(72))
  console.log()

  console.log(`📊 总条目数：${entries.length}`)
  console.log()

  // Category distribution
  const catCount = new Map<string, number>()
  for (const e of entries) {
    catCount.set(e.category, (catCount.get(e.category) || 0) + 1)
  }
  console.log('📦 各品类分布：')
  for (const [cat, cnt] of [...catCount.entries()].sort((a, b) => b[1] - a[1])) {
    console.log(`   ${cat.padEnd(22)} ${String(cnt).padStart(3)} 条`)
  }
  console.log()

  // name_en coverage
  function hasEn(name: string): boolean {
    if (EN_NAME_MAP[name]) return true
    const withoutParens = name.replace(/[（(][^）)]*[）)]/g, '').trim()
    if (EN_NAME_MAP[withoutParens]) return true
    const base = withoutParens.replace(/[^\u4e00-\u9fa5a-zA-Z0-9]/g, '').trim()
    return !!EN_NAME_MAP[base]
  }
  const hasEnMap = entries.filter(e => hasEn(e.product)).length
  const needsFallback = entries.length - hasEnMap
  console.log('🔤 name_en 处理：')
  console.log(`   ✅ 有中英对照映射：${hasEnMap} 条`)
  console.log(`   ⚠️  需手动补充（当前用中文名占位）：${needsFallback} 条`)
  if (needsFallback > 0) {
    console.log('   示例（前8条）：')
    entries.filter(e => !hasEn(e.product)).slice(0, 8).forEach(e => {
      console.log(`      "${e.product}" → name_en="${e.name_en}"`)
    })
  }
  console.log()

  // SKU samples
  console.log('🏷️  SKU 示例（各品类前3条）：')
  const byCat = new Map<string, Entry[]>()
  for (const e of entries) {
    if (!byCat.has(e.category)) byCat.set(e.category, [])
    byCat.get(e.category)!.push(e)
  }
  for (const [cat, list] of byCat) {
    console.log(`   [${cat}]`)
    list.slice(0, 3).forEach(e => {
      console.log(`      ${e.sku}  →  ${e.product}`)
    })
    if (list.length > 3) console.log(`      ... 共 ${list.length} 条`)
  }
  console.log()

  // OEM status
  const hasRealOem = entries.filter(e => /\d{8,}/.test(e.product)).length
  console.log('🔢 OEM 号状态：')
  console.log(`   ✅ 有真实 OEM 号（从产品名提取）：${hasRealOem} 条`)
  console.log(`   ⚠️  占位符（用 SKU 暂代，后续补录）：${entries.length - hasRealOem} 条`)
  console.log()

  // Duplicate product names
  const prodCounts = new Map<string, number>()
  for (const e of entries) {
    prodCounts.set(e.product, (prodCounts.get(e.product) || 0) + 1)
  }
  const dupProds = [...prodCounts.entries()].filter(([, v]) => v > 1)
  console.log('🔍 重复产品名（同一配件适配多车型）：')
  console.log(`   共 ${dupProds.length} 个名字重复，涉及 ${dupProds.reduce((s, [, v]) => s + v, 0)} 条记录`)
  console.log('   示例：')
  dupProds.slice(0, 8).forEach(([name, cnt]) => {
    console.log(`      "${name}" × ${cnt}`)
  })
  console.log()

  // Import plan
  console.log('💡 导入计划：')
  console.log(`   • 预计 upsert：${entries.length} 条`)
  console.log(`   • 幂等键：sku（唯一）`)
  console.log(`   • name_en：${hasEnMap} 条有英文，${needsFallback} 条中文占位`)
  console.log(`   • oem_number：全部用 SKU 占位，后续按 sku 补录`)
  console.log(`   • status：统一 active`)
  console.log(`   • schema 约束：name_en NOT NULL ✅，oem_number NOT NULL ✅（占位符满足）`)
  console.log()
  console.log('═'.repeat(72))
  console.log('  确认无误后运行：npx tsx scripts/import-catalog.ts --live')
  console.log('═'.repeat(72))
}

// ─── 主入口 ───────────────────────────────────────────────────────────────────

const mdPath = path.resolve(__dirname, '../../产品目录_德达汽配.md')
if (!fs.existsSync(mdPath)) {
  console.error(`❌ 找不到目录文件：${mdPath}`)
  process.exit(1)
}

const entries = parseCatalog(mdPath)
printStats(entries)
