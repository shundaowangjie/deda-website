/**
 * import-catalog-dryrun.ts — 产品目录导入 dry-run
 *
 * 解析 `产品目录_德达汽配.md`，打印导入统计，不做任何数据库写入。
 *
 * 运行：
 *   cd deda-products && npx tsx scripts/import-catalog-dryrun.ts
 */

import * as fs from 'fs'
import * as path from 'path'

// ─── 品类映射 ─────────────────────────────────────────────────────────────────

/** 四级标题（####）关键词 → 数据库 category */
const H4_CATEGORY_MAP: Record<string, string> = {
  '发动机': 'engine-parts',
  '传动系统': 'drivetrain',
  '底盘': 'chassis-suspension',
  '电气系统': 'electrical',
  '润滑油': 'filters',
  '滤清器': 'filters',
  '橡胶': 'other',
  '密封件': 'other',
  '胶管': 'other',
  '轮胎': 'other',
}

/** 产品名称关键词 → 品类（用于无四级标题的混合表格） */
const PRODUCT_CATEGORY_HINTS: [string[], string][] = [
  // engine-parts
  [['缸套', '活塞', '活塞环', '缸盖', '气门', '凸轮轴', '曲轴', '飞轮', '油底壳',
    '摇臂', '推杆', '挺柱', '喷油器', '喷油嘴', '高压油管', '燃油泵', '输油泵',
    '机油泵', '水泵', '节温器', '散热器', '水箱', '风扇', '增压器', '中冷器',
    '进气支管', '排气支管', '消声器', '排气总管', '气缸垫片', '曲轴油封',
    '凸轮轴油封', '燃气发动机油', '柴油发动机油', '柴油机油'], 'engine-parts'],
  // drivetrain
  [['离合器', '变速箱', '传动轴', '取力器', '万向节', '中间轴承', '十字轴',
    '变速箱齿轮', '变速箱轴', '变速箱同步器', '变速箱垫片'], 'drivetrain'],
  // chassis-suspension
  [['前桥', '后桥', '桥壳', '减速器', '差速器', '半轴', '盆角齿', '轮边减速器',
    '轮毂', '制动鼓', '制动盘', '制动蹄', '刹车片', '刹车皮', '刹车分泵',
    '刹车总泵', '制动器', '空气压缩机', '储气筒', '刹车阀', '高低阀', '手阀',
    '挂车阀', '方向机', '转向节', '主销', '支承销', '钢板弹簧', 'U型螺栓',
    '减震器', '空气弹簧', '悬挂气室', '车架大梁', '车架衬套', '连杆瓦', '主轴瓦'], 'chassis-suspension'],
  // electrical
  [['发电机', '起动机', '电瓶', '保险丝', '继电器', '组合开关', '灯光开关',
    '转向灯开关', '喇叭', '仪表盘', '水温传感器', '油压传感器', '车速传感器',
    '转速传感器', '曲轴位置传感器', '凸轮轴位置传感器', '进气压力传感器',
    '进气温度传感器', 'ECU', '线束', '大灯', '雾灯', '转向灯', '刹车灯',
    '示廓灯', '牌照灯', '电子控制', '传感器'], 'electrical'],
  // filters
  [['机油滤清器', '燃油滤清器', '空气滤清器', '柴油滤清器', '液压油滤清器',
    '变速箱油滤清器', '齿轮油', '液压油', '防冻液', '转向助力油', '制动液',
    '机油'], 'filters'],
  // other
  [['O型圈', '油封', '垫片', '胶管', '燃油管', '机油管', '水管', '进气管',
    '排气管', '刹车管', '轮胎'], 'other'],
]

function inferCategoryFromProduct(productName: string): string {
  for (const [keywords, cat] of PRODUCT_CATEGORY_HINTS) {
    for (const kw of keywords) {
      if (productName.includes(kw)) return cat
    }
  }
  return 'other'
}

