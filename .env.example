NEXT_PUBLIC_SUPABASE_URL=https://dubtupobtddeocmtfndf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# A. 国外邮件通知（Resend）：表单询价+拍照询价都会发邮件
#    申请地址 https://resend.com，免费额度 100 封/天
RESEND_API_KEY=
INQUIRY_NOTIFY_EMAIL=sales@dedaautoparts.com
# 发件人（需在 Resend 验证域名，默认可用 onboarding@resend.dev 测试）
RESEND_FROM=DEDA询价 <noreply@dedaautoparts.com>

# B. 国内企微推送：企业微信群 → 添加群机器人 → 复制 webhook
QYWX_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY

# C. 询价后台（/admin）：口令 + service_role key（Supabase 后台 API 设置里复制）
#    service key 绝不能加 NEXT_PUBLIC_ 前缀，只能放服务端
ADMIN_PASSWORD=请改成强口令
SUPABASE_SERVICE_ROLE_KEY=
